[Unit]
Description=Hotel Maintenance HTTPS proxy
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=hotel-caddy
Group=hotel-caddy
Environment=XDG_DATA_HOME=/var/lib/hotel-maintenance-caddy
Environment=XDG_CONFIG_HOME=/var/lib/hotel-maintenance-caddy/config
ExecStart=/usr/local/bin/hotel-caddy run --config /etc/hotel-maintenance-caddy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
StateDirectory=hotel-maintenance-caddy
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hotel-maintenance-caddy

[Install]
WantedBy=multi-user.target
